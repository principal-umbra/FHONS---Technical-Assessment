rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /evaluations_servicio_al_cliente/{document=**} {
      allow read, write: if true;
    }
    match /evaluations_perfil_profesional/{document=**} {
      allow read, write: if true;
    }
    match /evaluations_proceso_retroalimentacion/{document=**} {
      allow read, write: if true;
    }
    match /evaluations_proceso_guardia/{document=**} {
      allow read, write: if true;
    }
    match /evaluations_protocolo_tickets/{document=**} {
      allow read, write: if true;
    }
    match /evaluations_protocolo_migraciones/{document=**} {
      allow read, write: if true;
    }
    match /evaluations_protocolo_visitas/{document=**} {
      allow read, write: if true;
    }
    match /questionnaires/{document=**} {
      allow read, write: if true;
    }
    match /credentials/{document=**} {
      allow read, write: if true;
    }
    match /app_settings/{document=**} {
      allow read, write: if true;
    }
    match /questionnaire_assignments/{document=**} {
      allow read, write: if true;
    }
    match /laboratory_reports/{document=**} {
      allow read, write: if true;
    }
  }
}
